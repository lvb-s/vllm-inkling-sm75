# Host directory that contains the checkpoint directory (thinkingmachines/Inkling-2-Mini).
VLLM_MODELS_HOST=/srv/models
VLLM_MODEL_DIR=/models/Inkling-2-Mini

# 4x Tesla T10: TP=4. 2x RTX 2080 Ti: VLLM_GPUS=0,1 and VLLM_TP=2.
VLLM_GPUS=0,1,2,3
VLLM_TP=4
PORT=8011
VLLM_MAX_MODEL_LEN=65536
VLLM_MAX_NUM_SEQS=16
VLLM_GPU_MEMORY_UTILIZATION=0.92
VLLM_MM_IMAGE_LIMIT=1
# VLLM_API_KEY=
